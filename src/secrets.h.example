/**
 * secrets.h.example - Template for secret configuration
 * 
 * SETUP:
 * 1. Copy this file to src/secrets.h
 * 2. Fill in your actual credentials and addresses
 * 3. NEVER commit secrets.h (it's in .gitignore)
 * 
 * This file provides compile-time fallback Wi-Fi credentials for production
 * devices that haven't been provisioned with WifiStore yet. After first boot
 * with these credentials, they will be written to EEPROM WifiStore.
 */

#ifndef SECRETS_H
#define SECRETS_H

// Wi-Fi Networks (used as fallback if WifiStore is empty)
// Listed twice: first attempt often returns before DHCP completes
#define WIFI_SSID_1 "YourSSID"
#define WIFI_PASSWORD_1 "YourPassword"

#define WIFI_SSID_2 "YourSSID"      // Duplicate for retry
#define WIFI_PASSWORD_2 "YourPassword"

#define WIFI_SSID_3 "BackupSSID"
#define WIFI_PASSWORD_3 "BackupPassword"

#define WIFI_SSID_4 "AnotherBackup"
#define WIFI_PASSWORD_4 "AnotherPassword"

// Ethereum Contract Address (NFT gating)
#define DOOR_CONTRACT_ADDRESS "0x3158e836ec0e85A46f7a7208d91EA9837A0C6ccC"

// Admin Ethereum Addresses (bypass NFT checks)
#define ADMIN_ADDRESS_1 "0xC067A53c91258ba513059919E03B81CF93f57Ac7"
#define ADMIN_ADDRESS_2 "0x7e4b1da13c4a2a73fd05e928a6ed81b0a5d3007b"

// Additional secrets can be added here as needed
// Example: API keys, etc.

#endif // SECRETS_H
